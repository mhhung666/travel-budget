{
  "name": "travel-budget",
  "version": "4.2.0",
  "description": "一個輕量化的旅行記帳與分帳應用程式,適合多人出國旅行時使用。",
  "main": "index.js",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css}\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ai-import-eval": "RUN_AI_IMPORT_EVAL=1 vitest run src/__tests__/itineraryImportLiveEvaluation.test.ts",
    "test:a11y": "vitest run src/__tests__/phase4Accessibility.test.tsx src/__tests__/phase4Flows.test.tsx src/__tests__/itineraryImportAccessibility.test.tsx",
    "test:coverage": "vitest run --coverage",
    "migrate:status": "migrate-mongo status",
    "migrate:up": "migrate-mongo up",
    "migrate:down": "migrate-mongo down",
    "migrate:create": "migrate-mongo create",
    "stats:explain": "node scripts/explain-stats-expenses.mjs",
    "stats:benchmark": "node scripts/benchmark-stats.mjs",
    "generate:catalogs": "node scripts/generate-catalogs.mjs"
  },
  "keywords": [
    "travel",
    "budget",
    "expense",
    "split",
    "nextjs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.37",
    "@ai-sdk/openai": "^4.0.27",
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@serwist/next": "^9.5.11",
    "@tanstack/query-async-storage-persister": "^5.101.1",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-persist-client": "^5.101.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^1.3.1",
    "ai": "^7.0.48",
    "bcryptjs": "^3.0.3",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cookie": "^1.1.1",
    "dotenv": "^17.2.3",
    "exifr": "^7.1.3",
    "html-to-image": "^1.11.13",
    "idb-keyval": "^6.2.5",
    "jose": "^6.1.3",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "lucide-react": "^0.563.0",
    "mongoose": "^9.7.0",
    "next": "^16.1.1",
    "next-intl": "^4.7.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "4.1.3",
    "react-markdown": "^10.1.0",
    "recharts": "^3.7.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.16.0",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.9.3",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
