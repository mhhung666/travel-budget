{
  "name": "travel-budget-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:web": "pnpm --filter @travel-budget/web dev",
    "dev:mobile": "pnpm --filter travel-budget-mobile dev",
    "build": "pnpm --filter @travel-budget/web build",
    "start": "pnpm --filter @travel-budget/web start",
    "mobile:ios": "pnpm --filter travel-budget-mobile ios",
    "mobile:android": "pnpm --filter travel-budget-mobile android",
    "mobile:web": "pnpm --filter travel-budget-mobile web",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm --filter @travel-budget/web lint && pnpm --filter travel-budget-mobile lint",
    "format": "prettier --write package.json pnpm-workspace.yaml .github docs README.md AGENTS.md CLAUDE.md packages && pnpm --filter @travel-budget/web format && pnpm --filter travel-budget-mobile format",
    "format:check": "prettier --check package.json pnpm-workspace.yaml .github docs README.md AGENTS.md CLAUDE.md packages && pnpm --filter @travel-budget/web format:check && pnpm --filter travel-budget-mobile format:check",
    "check": "pnpm contracts:check && pnpm typecheck && pnpm lint && pnpm format:check",
    "test": "pnpm test:run",
    "test:run": "pnpm --filter @travel-budget/web test:run && pnpm --filter travel-budget-mobile test",
    "test:mobile": "pnpm --filter travel-budget-mobile test",
    "export:check": "pnpm --filter travel-budget-mobile export:check",
    "contracts:generate": "pnpm --filter @travel-budget/contracts generate",
    "contracts:check": "pnpm --filter @travel-budget/contracts check"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  }
}
