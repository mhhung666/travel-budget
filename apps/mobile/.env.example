# Public API address only. Never put secrets in EXPO_PUBLIC_* variables.
# The matching travel-budget backend changes must be running at this address.
# iOS simulator: localhost; Android emulator: 10.0.2.2; physical device: your computer's LAN IP.
# Production builds require HTTPS.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Optional canonical Web origin for invitation links when different from the API origin.
# Must match this environment's backend APP_URL origin (no path/query/credentials).
# EXPO_PUBLIC_WEB_ORIGIN=https://travel.example.com
