# JWT Secret Key (必填，至少 32 字元；無預設 fallback，缺漏或過短將直接拋錯)
# 產生方式: openssl rand -base64 48
JWT_SECRET=

# Node Environment
NODE_ENV=development

# MongoDB 連線字串 (不帶 NEXT_PUBLIC_ 前綴，不暴露給前端)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/travel-budget

# AI 行程匯入與記帳草稿（未設定時 endpoint 回 FEATURE_DISABLED，其餘手動功能不受影響）。
# Gateway：AI_PROVIDER=vercel、AI_MODEL 使用 creator/model 格式，並設定 Gateway key。
# OpenAI 直連：AI_PROVIDER=openai、AI_MODEL 使用模型名稱，並設定 OpenAI key。
AI_PROVIDER=
AI_MODEL=
AI_RECEIPT_MODEL=
AI_EXPENSE_TEXT_MODEL=
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
# 所有 AI 模型呼叫共用 timeout（毫秒，1000–120000；未設定時 30000）。
AI_TIMEOUT_MS=30000

# Shared AI persistent UTC-day limits (MongoDB-backed; safe across Serverless instances).
# Legacy AI_IMPORT_* names remain accepted for deployment compatibility.
AI_DAILY_USER_REQUESTS=5
AI_DAILY_TRIP_REQUESTS=10
AI_DAILY_GLOBAL_REQUESTS=50
# Cost values use integer micro-USD (1 USD = 1,000,000). Keep all four at 0 for a free model.
# For paid models, set the current provider prices and reserve >= the maximum expected request cost.
AI_DAILY_COST_LIMIT_MICRO_USD=0
AI_REQUEST_COST_RESERVE_MICRO_USD=0
AI_INPUT_MICRO_USD_PER_MILLION_TOKENS=0
AI_OUTPUT_MICRO_USD_PER_MILLION_TOKENS=0

# Cloudflare R2 (blob 儲存：收據 / 頭像)。未設定時 app 仍可啟動，只有上傳功能會回錯。
# 需在 R2 後台建立兩個 bucket，並對 avatars bucket 開啟 public access。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_RECEIPTS_BUCKET=travel-budget-receipts
R2_AVATARS_BUCKET=travel-budget-avatars
# 公開頭像 bucket 的對外基底 URL (r2.dev 或自訂網域，不含結尾斜線)
R2_AVATARS_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Resend (Email 通知)。未設定時 app 仍可啟動，只是不寄 Email (站內通知不受影響)。
# 需在 Resend 後台取得 API key，並驗證寄件網域。
RESEND_API_KEY=
# 寄件者地址，網域須已在 Resend 驗證。可帶顯示名稱，例: "旅行記帳 <noreply@yourdomain.com>"
RESEND_FROM=noreply@yourdomain.com
# 站台對外基底 URL (不含結尾斜線)，供 Email 內連結組成絕對網址。未設定時連結退回相對路徑。
APP_URL=https://your-app.example.com

# 排程任務 (Vercel Cron) 共享密鑰。設定後 Vercel 觸發 cron 會自動帶 Authorization
# header；/api/cron/* 路由用它驗證請求。未設定時 cron route 一律拒絕 (避免被公開觸發)。
# 產生方式: openssl rand -base64 32
CRON_SECRET=

# Web Push (瀏覽器推播通知)。未設定時 app 仍可啟動，只是推播不啟用 (前端開關停用、
# 後端不送推播；站內通知 / Email 不受影響)。
# 產生金鑰: npx web-push generate-vapid-keys  (或 node -e "console.log(require('web-push').generateVAPIDKeys())")
# 同一個環境的 public / private 必須是同一對；訂閱綁定公鑰，伺服器須用對應私鑰才推得到。
# 公鑰刻意帶 NEXT_PUBLIC_ 前綴暴露給前端 (subscribe 需要、非機密)；私鑰維持 server-only。
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID 聯絡識別 (mailto: 或 https URL)，推播服務據此聯絡寄件方。
VAPID_SUBJECT=mailto:you@example.com
