# JWT Secret Key (必填，至少 32 字元；無預設 fallback，缺漏或過短將直接拋錯)
# 產生方式: openssl rand -base64 48
JWT_SECRET=

# Node Environment
NODE_ENV=development

# MongoDB 連線字串 (不帶 NEXT_PUBLIC_ 前綴，不暴露給前端)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/travel-budget

# Cloudflare R2 (blob 儲存：收據 / 頭像)。未設定時 app 仍可啟動，只有上傳功能會回錯。
# 需在 R2 後台建立兩個 bucket，並對 avatars bucket 開啟 public access。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_RECEIPTS_BUCKET=travel-budget-receipts
R2_AVATARS_BUCKET=travel-budget-avatars
# 公開頭像 bucket 的對外基底 URL (r2.dev 或自訂網域，不含結尾斜線)
R2_AVATARS_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Resend (Email 通知)。未設定時 app 仍可啟動，只是不寄 Email (站內通知不受影響)。
# 需在 Resend 後台取得 API key，並驗證寄件網域。
RESEND_API_KEY=
# 寄件者地址，網域須已在 Resend 驗證。可帶顯示名稱，例: "旅行記帳 <noreply@yourdomain.com>"
RESEND_FROM=noreply@yourdomain.com
# 站台對外基底 URL (不含結尾斜線)，供 Email 內連結組成絕對網址。未設定時連結退回相對路徑。
APP_URL=https://your-app.example.com
