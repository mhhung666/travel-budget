# JWT Secret Key (請在生產環境更換為隨機字符串)
JWT_SECRET=your-secret-key-change-in-production

# Node Environment
NODE_ENV=development

# MongoDB 連線字串 (遷移目標，不帶 NEXT_PUBLIC_ 前綴，不暴露給前端)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/travel-budget

# Supabase 配置 (遷移期間暫留，完成後移除)
# 從 Supabase Dashboard -> Settings -> API 獲取
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
